{
  "name": "mis-tareas-pc",
  "version": "1.0.0",
  "description": "Mis Tareas - Aplicación de escritorio 100% local para gestionar tus tareas",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "preview": "tauri build --debug",
    "vendor": "node scripts/vendor.mjs",
    "pwa": "node scripts/pwa.mjs",
    "movil": "node scripts/movil.mjs",
    "movil:lan": "node scripts/movil.mjs --lan",
    "movil:sync": "cap sync android",
    "apk": "cd android && gradlew.bat assembleDebug",
    "apk:release": "cd android && gradlew.bat assembleRelease",
    "inicio": "electron .",
    "instalador": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.mistareas.app",
    "productName": "Mis Tareas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*"
    ],
    "win": {
      "icon": "src-tauri/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "uninstallDisplayName": "Mis Tareas"
    }
  },
  "keywords": [
    "tareas",
    "task-manager",
    "desktop",
    "tauri",
    "offline",
    "local"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/cli": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.1",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3"
  }
}
