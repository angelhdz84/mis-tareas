{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mis Tareas",
  "version": "1.0.0",
  "identifier": "com.mistareas.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": null,
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Mis Tareas",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "Mis Tareas"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 Mis Tareas",
    "category": "Productivity",
    "shortDescription": "Gestor de tareas 100% local para Windows",
    "longDescription": "Aplicación de escritorio para gestionar tus tareas, con recordatorios, etiquetas, subtareas, recurrencias y vistas Kanban/Lista. Todo se guarda localmente en tu PC.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["Spanish", "English"],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
